{
  "name": "veramo",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "pnpm build:js && pnpm build:api && pnpm build:schema",
    "build:js": "pnpm -r --stream build",
    "build:api": "pnpm -r --stream extract-api",
    "build:schema": "pnpm -r --stream generate-plugin-schema",
    "lint": "echo \"linting not yet enabled\"",
    "test:integration-build": "pnpm test:integration-prepare && pnpm test:integration-pretty",
    "test:integration-prepare": "tsx ./scripts/prepare-integration-tests.ts",
    "test:integration-pretty": "prettier --write __tests__/shared/documentationExamples.ts",
    "test:integration": "pnpm test:integration-build && pnpm test:ci",
    "test:ci": "vitest run --coverage",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:browser": "cd packages/test-react-app && pnpm test:browser",
    "veramo": "cross-env NODE_NO_WARNINGS=1 ./packages/cli/bin/veramo.js",
    "prettier": "prettier --write \"{packages,docs,__tests__,!build}/**/*.{ts,js,json,md,yml}\"",
    "build-clean": "rimraf --glob ./packages/*/build ./packages/*/api ./packages/*/node_modules ./packages/*/tsconfig.tsbuildinfo ./temp ./tmp",
    "changeset": "changeset",
    "release:publish": "changeset publish",
    "release:snapshot": "./scripts/release-snapshot.sh",
    "docs": "pnpm docs:copy && pnpm docs:build",
    "docs:copy": "tsx ./scripts/docs-copy.ts",
    "docs:build": "tsx ./scripts/docs-build.ts && pnpm docs:pretty",
    "docs:pretty": "prettier --write docs/**/*.md"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@metamask/eth-sig-util": "9.0.0",
    "@microsoft/api-documenter": "7.30.15",
    "@microsoft/api-extractor": "7.59.1",
    "@microsoft/api-extractor-model": "7.33.12",
    "@microsoft/tsdoc": "0.17.0",
    "@noble/hashes": "2.4.0",
    "@stablelib/ed25519": "2.1.0",
    "@transmute/credentials-context": "0.7.0-unstable.82",
    "@types/express": "5.0.6",
    "@types/fs-extra": "11.0.4",
    "@types/node": "26.5.1",
    "@types/uuid": "11.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "caip": "1.1.1",
    "credential-status": "3.0.4",
    "cross-env": "10.1.0",
    "did-jwt": "9.0.2",
    "did-jwt-vc": "5.0.1",
    "did-resolver": "6.0.0",
    "ethers": "6.13.4",
    "ethr-did-resolver": "14.1.4",
    "express": "5.3.0",
    "ganache": "7.9.2",
    "json-schema": "0.4.0",
    "nock": "15.0.1",
    "openapi-types": "12.1.3",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "sqlite3": "6.0.1",
    "ts-json-schema-generator": "3.0.0-native.5",
    "tsx": "4.23.13",
    "typeorm": "1.1.2",
    "typescript": "7.0.2",
    "uint8arrays": "6.1.1",
    "uuid": "14.0.3",
    "vitest": "^5.0.1",
    "web-did-resolver": "3.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/decentralized-identity/veramo.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
