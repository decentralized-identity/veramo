{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": [
      "vitest/globals"
    ],
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["**/__tests__/**/*", "**/build/**/*"],
  "references": [
    { "path": "../core" },
    { "path": "../core-types" },
    { "path": "../credential-jwt" },
    { "path": "../credential-ld" },
    { "path": "../credential-w3c" },
    { "path": "../data-store" },
    { "path": "../data-store-json" },
    { "path": "../did-comm" },
    { "path": "../did-jwt" },
    { "path": "../did-manager" },
    { "path": "../did-provider-ethr" },
    { "path": "../did-provider-jwk" },
    { "path": "../did-provider-key" },
    { "path": "../did-provider-peer" },
    { "path": "../did-provider-pkh" },
    { "path": "../did-provider-web" },
    { "path": "../did-resolver" },
    { "path": "../key-manager" },
    { "path": "../kms-local" },
    { "path": "../kms-web3" },
    { "path": "../message-handler" },
    { "path": "../selective-disclosure" },
    { "path": "../test-utils" },
    { "path": "../url-handler" },
    { "path": "../utils" }
  ]
}
